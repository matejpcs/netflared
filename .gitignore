# ====================================================================
# Sestavení a výstupy (Builds)
# ====================================================================
# Ignoruje všechny složky build/ v jakékoliv úrovni projektu
build/
bin/
out/

# ====================================================================
# Gradle a Gradlew
# ====================================================================
# Lokální cache a konfigurační složka Gradle
.gradle/

# Spouštěcí skripty Gradle wrapperu (pro Windows i Linux/macOS)
gradlew
gradlew.bat

# Složka wrapperu obsahující staženou distribuci a vlastnosti
gradle/wrapper/

# ====================================================================
# Vývojové prostředí (IDE) - IntelliJ IDEA / Android Studio
# ====================================================================
# Ignoruje uživatelské nastavení projektu a workspace
.idea/

# Volitelné: Ignoruje také soubory modulů vytvořené IntelliJ
*.iml
